#!/bin/sh
# Launcher for redirect-proxy release bundles.
#
# Layout:  <prefix>/bin/redirect-proxy   (this script)
#          <prefix>/lib/<app>/ebin       (compiled application and dependencies)
#          <prefix>/erts/                (optional bundled Erlang runtime)
#
# Without a bundled runtime the `erl` found in PATH is used (OTP 27+).
# Extra VM flags can be passed through the ERL_FLAGS environment variable.
set -eu

self=$0
while [ -h "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
prefix=$(cd "$(dirname "$self")/.." && pwd -P)

if [ -d "$prefix/erts" ]; then
  for dir in "$prefix"/erts/erts-*; do erts_dir=$dir; done
  ROOTDIR="$prefix/erts"
  BINDIR="$erts_dir/bin"
  EMU=beam
  PROGNAME=erl
  export ROOTDIR BINDIR EMU PROGNAME
  erl="$BINDIR/erlexec"
else
  erl=erl
fi

# Files it creates (redirects.json, backups, logs, the audit log) are not
# readable by others, whatever the umask it was started with (the Docker
# image has no other way to set it; systemd's unit sets 0027 already). A
# stricter umask is kept.
umask "$(printf '%04o' $(( $(umask) | 7 )))"

# Plain log lines when not attached to a terminal (journald, docker logs...)
if [ ! -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  NO_COLOR=1
  export NO_COLOR
fi

# +sbwt none: do not busy-wait schedulers (lower idle CPU usage)
# +K true: kernel poll (default on modern OTP, kept explicit)
# +P 131072: a process per connection, and connections are limited by the
#   ports (65 536 by default, +Q): the default table of 1 048 576 processes
#   costs ~12 MB of memory for nothing (ERL_FLAGS="+Q … +P …" raises both)
# +spp true: port parallelism, a socket's work is scheduled rather than done
#   by the process that sends to it: ~23 % lower p99 latency under load
#   (Benchmark workflow), throughput unchanged
# -noshell / no distribution: the node never opens an Erlang distribution port
exec "$erl" \
  +sbwt none +sbwtdcpu none +sbwtdio none \
  +K true \
  +P 131072 \
  +spp true \
  -noshell \
  -pa "$prefix"/lib/*/ebin \
  -eval "redirect_proxy@@main:run(redirect_proxy)" \
  -extra "$@"
